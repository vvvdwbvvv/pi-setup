{
  "name": "agent-essential-runtime",
  "version": "0.1.0",
  "description": "Standalone agent tool runtime (MCP + CLI) compatible with cursor-essential contracts",
  "type": "module",
  "bin": {
    "agent-essential": "./dist/src/surfaces/cli/main.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "contracts/tools.json"
  ],
  "scripts": {
    "generate": "tsx contracts/generate.ts",
    "build": "npm run generate && tsc",
    "test": "npm run build && node --test dist/tests/**/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "10.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
