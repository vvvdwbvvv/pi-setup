{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "@@PI_MIGRATION_HOME@@/.pi/agent/pi-runtime/node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai": [
        "@@PI_MIGRATION_HOME@@/.pi/agent/pi-runtime/node_modules/@earendil-works/pi-ai/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai/models": [
        "@@PI_MIGRATION_HOME@@/.pi/agent/pi-runtime/node_modules/@earendil-works/pi-ai/dist/models.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
